<%- include("header.ejs") %>


<!-- Form -->
    <div class="container bg-dark p-5 mt-5 rounded">
        <form action="/adddept" method="post">
            <div class="form-group">
                <input type="text" class="form-control control" name="name" id="name" placeholder="Enter Dept name">
            </div>
            <div class="form-group">
                <input type="submit" class="form-control control btn btn-primary " name="submit" value="Submit">
            </div>

            <% if (msg) { %>
              <div class="alert alert-success" role="alert">
            <%= msg %>
            </div>
            <% } %>
           
        </form>
    </div>

<%- include("footer.ejs") %>