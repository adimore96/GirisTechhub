<%- include("header.ejs") %>
<div class="container">
    <h3>Update Department</h3>

    <!-- Form -->
    <div class="container bg-dark p-5 mt-5 rounded">
        <form action="/updateDept" method="post">
            <div class="form-group">
                <input type="text" class="form-control control" name="name" id="name" placeholder="Enter Dept name" value="<%= data?.deptname || '' %>">
                <input type="text" name="deptid" id="deptid" value="<%= data.deptid %>" hidden>
            </div>
            <div class="form-group">
                <input type="submit" class="form-control control btn btn-primary ">
            </div>

           
        </form>
    </div>
</div>
<%- include("footer.ejs") %>